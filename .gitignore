# This checkout publishes presentation material only.
# New paths require explicit review before extending this allowlist.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/LICENSE.md
!/NOTICE.md
!/SOURCE-CODE.md
!/SECURITY.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/docs/
!/assets/

/docs/**
!/docs/README.md
!/docs/gallery.md
!/docs/provenance.md
!/docs/roadmap.md
!/docs/sources.md
!/docs/design/
!/docs/design/overview.md
!/docs/product/
!/docs/product/context.md
!/docs/quality/
!/docs/quality/verification.md

/assets/*
!/assets/fact-indonesia-hero.png
!/assets/fact-indonesia-catalogue.png
!/assets/fact-indonesia-recovery.png
!/assets/manifest.json

# Git ignores do not affect existing history or files staged with --force.
